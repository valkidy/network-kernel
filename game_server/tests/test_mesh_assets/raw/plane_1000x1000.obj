# Flat plane
# Size: 1000 x 1000 on XZ
# Y = 0
# Normal: +Y
# plane_200x200 scaled up five times, for agent_cpu_bench's open-world table.
o FlattenPlane_1000x1000

v -500.0 0.0 -500.0
v -500.0 0.0  500.0
v  500.0 0.0  500.0
v  500.0 0.0 -500.0

vt 0.0 0.0
vt 0.0 1.0
vt 1.0 1.0
vt 1.0 0.0

vn 0.0 1.0 0.0

f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
