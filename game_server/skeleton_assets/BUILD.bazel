licenses(["notice"])

load(":skeleton_asset_rules.bzl", "skeleton_asset")

package(default_visibility = ["//visibility:public"])

# The locomotion rigs, exported from LocomotionModel.unity by
# //tools:unity_scene_to_glb with no coordinate conversion. asset_id 1 and 2
# belonged to simplified_monster_sim_v4 and rock_robot_biped_24u_v3 and are
# retired with them; ids are never reused, so a stale catalog naming one fails
# to resolve rather than silently binding to a different rig.
skeleton_asset(
    name = "simplified_biped",
    src = "raw/simplified_biped.glb",
    rig = "raw/simplified_biped.rig.yaml",
    asset_id = 3,
)

skeleton_asset(
    name = "simplified_quadruped",
    src = "raw/simplified_quadruped.glb",
    rig = "raw/simplified_quadruped.rig.yaml",
    asset_id = 4,
)

skeleton_asset(
    name = "simplified_tripod",
    src = "raw/simplified_tripod.glb",
    rig = "raw/simplified_tripod.rig.yaml",
    asset_id = 5,
)
