licenses(["notice"])

package(default_visibility = ["//visibility:public"])

genrule(
    name = "gameplay_bundle_base",
    srcs = ["//game_server:gameplay_catalog_bundle_sources"],
    outs = ["gameplay_bundle_base.zip"],
    cmd = """
set -euo pipefail
out_path="$$(pwd)/$@"
bundle_root="$(@D)/bundle_root"
rm -rf "$$bundle_root"
mkdir -p "$$bundle_root/action_templates" "$$bundle_root/action_graph_templates" "$$bundle_root/status_effect_templates" "$$bundle_root/weapon_templates" "$$bundle_root/projectile_templates" "$$bundle_root/collider_templates" "$$bundle_root/entity_templates" "$$bundle_root/item_templates" "$$bundle_root/skeleton_assets/generated"
for src in $(SRCS); do
  case "$$src" in
    */test_catalogs/legged_locomotion/gameplay_catalog.yaml)
      cp "$$src" "$$bundle_root/legged_locomotion_gameplay_catalog.yaml"
      ;;
    */gameplay_catalog.yaml)
      cp "$$src" "$$bundle_root/gameplay_catalog.yaml"
      ;;
    */weapon_templates/*.yaml)
      cp "$$src" "$$bundle_root/weapon_templates/$$(basename "$$src")"
      ;;
    */action_templates/*.yaml)
      cp "$$src" "$$bundle_root/action_templates/$$(basename "$$src")"
      ;;
    */action_graph_templates/*.yaml)
      cp "$$src" "$$bundle_root/action_graph_templates/$$(basename "$$src")"
      ;;
    */status_effect_templates/*.yaml)
      cp "$$src" "$$bundle_root/status_effect_templates/$$(basename "$$src")"
      ;;
    */projectile_templates/*.yaml)
      cp "$$src" "$$bundle_root/projectile_templates/$$(basename "$$src")"
      ;;
    */entity_templates/*.yaml)
      cp "$$src" "$$bundle_root/entity_templates/$$(basename "$$src")"
      ;;
    */item_templates/*.yaml)
      cp "$$src" "$$bundle_root/item_templates/$$(basename "$$src")"
      ;;
    */collider_templates/*.yaml)
      cp "$$src" "$$bundle_root/collider_templates/$$(basename "$$src")"
      ;;
    */skeleton_assets/generated/*.ozz|*/skeleton_assets/generated/*.skeleton_manifest.json|*/skeleton_assets/generated/*.rig.yaml)
      cp "$$src" "$$bundle_root/skeleton_assets/generated/$$(basename "$$src")"
      ;;
  esac
done
# Normalize entry timestamps and ordering so the archive is byte-reproducible:
# clients key their catalog cache by the bundle SHA-256, so build-time mtimes
# would invalidate every cached bundle on each rebuild.
find "$$bundle_root" -exec touch -t 198001010000 {} +
(cd "$$bundle_root" && find . -mindepth 1 | sed 's|^\\./||' | LC_ALL=C sort | /usr/bin/zip -q -X -@ "$$out_path")
rm -rf "$$bundle_root"
""",
)

genrule(
    name = "bundle",
    srcs = [
        ":gameplay_bundle_base",
        "//game_server/mesh_assets:cooked_mesh_assets",
    ],
    outs = ["bundle.zip"],
    cmd = """
set -euo pipefail
out_path="$$(pwd)/$@"
bundle_root="$(@D)/merged_bundle_root"
rm -rf "$$bundle_root"
mkdir -p "$$bundle_root/mesh_assets/jolt" "$$bundle_root/mesh_assets/recast"
for src in $(SRCS); do
  case "$$src" in
    */gameplay_bundle_base.zip)
      /usr/bin/unzip -q "$$src" -d "$$bundle_root"
      ;;
    */generated/jolt/*.joltmesh)
      cp "$$src" "$$bundle_root/mesh_assets/jolt/$$(basename "$$src")"
      ;;
    */generated/recast/*.navmesh)
      cp "$$src" "$$bundle_root/mesh_assets/recast/$$(basename "$$src")"
      ;;
  esac
done
find "$$bundle_root" -exec touch -t 198001010000 {} +
(cd "$$bundle_root" && find . -mindepth 1 | sed 's|^\\./||' | LC_ALL=C sort | /usr/bin/zip -q -X -@ "$$out_path")
rm -rf "$$bundle_root"
""",
)
