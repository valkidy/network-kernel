licenses(["notice"])

package(default_visibility = ["//visibility:public"])

genrule(
    name = "gameplay_bundle_base",
    srcs = ["//game_server:gameplay_catalog_bundle_sources"],
    outs = ["gameplay_bundle_base.zip"],
    cmd = """
set -euo pipefail
out_path="$$(pwd)/$@"
bundle_root="$(@D)/bundle_root"
rm -rf "$$bundle_root"
mkdir -p "$$bundle_root/action_templates" "$$bundle_root/action_graph_templates" "$$bundle_root/status_effect_templates" "$$bundle_root/sp_attack_templates" "$$bundle_root/weapon_templates" "$$bundle_root/projectile_templates" "$$bundle_root/collider_templates" "$$bundle_root/entity_templates" "$$bundle_root/item_templates" "$$bundle_root/patrol_templates" "$$bundle_root/scene_templates" "$$bundle_root/skeleton_assets/generated" "$$bundle_root/stamp_templates" "$$bundle_root/terrain_assets"
for src in $(SRCS); do
  case "$$src" in
    */test_catalogs/legged_locomotion/gameplay_catalog.yaml)
      cp "$$src" "$$bundle_root/legged_locomotion_gameplay_catalog.yaml"
      ;;
    */gameplay_catalog.yaml)
      cp "$$src" "$$bundle_root/gameplay_catalog.yaml"
      ;;
    */weapon_templates/*.yaml)
      cp "$$src" "$$bundle_root/weapon_templates/$$(basename "$$src")"
      ;;
    */action_templates/*.yaml)
      cp "$$src" "$$bundle_root/action_templates/$$(basename "$$src")"
      ;;
    */action_graph_templates/*.yaml)
      # Graphs keep their subdirectory (common/, derived/<owner_type>/). The
      # loader reads the whole tree; flattening it here would let two
      # same-named files overwrite each other instead of being refused.
      graph_path="$${src#*/action_graph_templates/}"
      mkdir -p "$$bundle_root/action_graph_templates/$$(dirname "$$graph_path")"
      cp "$$src" "$$bundle_root/action_graph_templates/$$graph_path"
      ;;
    */status_effect_templates/*.yaml)
      cp "$$src" "$$bundle_root/status_effect_templates/$$(basename "$$src")"
      ;;
    */sp_attack_templates/*.yaml)
      cp "$$src" "$$bundle_root/sp_attack_templates/$$(basename "$$src")"
      ;;
    */projectile_templates/*.yaml)
      cp "$$src" "$$bundle_root/projectile_templates/$$(basename "$$src")"
      ;;
    */entity_templates/*.yaml)
      cp "$$src" "$$bundle_root/entity_templates/$$(basename "$$src")"
      ;;
    */item_templates/*.yaml)
      cp "$$src" "$$bundle_root/item_templates/$$(basename "$$src")"
      ;;
    */collider_templates/*.yaml)
      cp "$$src" "$$bundle_root/collider_templates/$$(basename "$$src")"
      ;;
    */scene_templates/*.yaml)
      cp "$$src" "$$bundle_root/scene_templates/$$(basename "$$src")"
      ;;
    */patrol_templates/*.yaml)
      cp "$$src" "$$bundle_root/patrol_templates/$$(basename "$$src")"
      ;;
    */stamp_templates/*.yaml|*/stamp_templates/*.hf)
      cp "$$src" "$$bundle_root/stamp_templates/$$(basename "$$src")"
      ;;
    */terrain_assets/*.nkgm|*/terrain_assets/*.nkgl)
      cp "$$src" "$$bundle_root/terrain_assets/$$(basename "$$src")"
      ;;
    */skeleton_assets/generated/*.ozz|*/skeleton_assets/generated/*.skeleton_manifest.json|*/skeleton_assets/generated/*.rig.yaml)
      cp "$$src" "$$bundle_root/skeleton_assets/generated/$$(basename "$$src")"
      ;;
  esac
done
# One entry per scene template that can start a session, the catalog with
# start_scene set to it, so a server picks its first map by entry path
# without a rebuild (docs/START_SCENE_PLAN.md). A random terrain (seed -1)
# cannot start one.
for scene in "$$bundle_root"/scene_templates/*.yaml; do
  id="$$(basename "$$scene")"
  id="$${id%%_scene_*}"
  if grep -q "^  seed: -1" "$$scene"; then
    continue
  fi
  entry="$$bundle_root/gameplay_catalog.scene_$$id.yaml"
  sed "s/^start_scene: .*/start_scene: $$id/" "$$bundle_root/gameplay_catalog.yaml" > "$$entry"
  grep -q "^start_scene: $$id$$" "$$entry"
done
# Normalize entry timestamps and ordering so the archive is byte-reproducible:
# clients key their catalog cache by the bundle SHA-256, so build-time mtimes
# would invalidate every cached bundle on each rebuild.
find "$$bundle_root" -exec touch -t 198001010000 {} +
(cd "$$bundle_root" && find . -mindepth 1 | sed 's|^\\./||' | LC_ALL=C sort | /usr/bin/zip -q -X -@ "$$out_path")
rm -rf "$$bundle_root"
""",
)

# Everything but the cooked terrain recipe; terrain_recipe reads it to
# generate the recipe, and bundle adds it.
genrule(
    name = "bundle_uncooked",
    srcs = [
        ":gameplay_bundle_base",
        "//game_server/gameplay_catalog/mesh_assets:cooked_mesh_assets",
    ],
    outs = ["bundle_uncooked.zip"],
    cmd = """
set -euo pipefail
out_path="$$(pwd)/$@"
bundle_root="$(@D)/merged_bundle_root"
rm -rf "$$bundle_root"
mkdir -p "$$bundle_root/mesh_assets/jolt" "$$bundle_root/mesh_assets/recast"
for src in $(SRCS); do
  case "$$src" in
    */gameplay_bundle_base.zip)
      /usr/bin/unzip -q "$$src" -d "$$bundle_root"
      ;;
    */mesh_assets/jolt/*.joltmesh)
      cp "$$src" "$$bundle_root/mesh_assets/jolt/$$(basename "$$src")"
      ;;
    */mesh_assets/recast/*.navmesh)
      cp "$$src" "$$bundle_root/mesh_assets/recast/$$(basename "$$src")"
      ;;
  esac
done
find "$$bundle_root" -exec touch -t 198001010000 {} +
(cd "$$bundle_root" && find . -mindepth 1 | sed 's|^\\./||' | LC_ALL=C sort | /usr/bin/zip -q -X -@ "$$out_path")
rm -rf "$$bundle_root"
""",
)

# Every terrain scene template's recipe, generated (layout or hand-placed
# stamps, checks, retries, fallback) from its seed at build time, so every
# server and client of this bundle composes the same map
# (docs/KERNEL_TERRAIN_IMPLEMENTATION_PLAN.md P3). One rule for all of them
# (docs/LEVEL_AUTHORING_TOOLS_PLAN.md G6): each lands at the path its
# terrain.recipe names, so a new terrain template needs no rule of its own.
# Templates with seed -1 are generated when opened instead. The report lists
# every attempt of every template. The archive always holds terrain/, so it is
# never empty.
genrule(
    name = "terrain_recipes",
    srcs = [":bundle_uncooked"],
    outs = [
        "terrain_recipes.zip",
        "terrain_recipes_report.txt",
    ],
    cmd = """
set -euo pipefail
out_path="$$(pwd)/$(location terrain_recipes.zip)"
recipes_root="$(@D)/terrain_recipes_root"
rm -rf "$${recipes_root:?}"
mkdir -p "$$recipes_root/terrain"
$(location //game_server:terrain_recipe_cook) --all $(location :bundle_uncooked) gameplay_catalog.yaml "$$recipes_root" > $(location terrain_recipes_report.txt)
find "$$recipes_root" -exec touch -t 198001010000 {} +
(cd "$$recipes_root" && find . -mindepth 1 | sed 's|^\\./||' | LC_ALL=C sort | /usr/bin/zip -q -X -@ "$$out_path")
rm -rf "$${recipes_root:?}"
""",
    tools = ["//game_server:terrain_recipe_cook"],
)

genrule(
    name = "bundle",
    srcs = [
        ":bundle_uncooked",
        ":terrain_recipes.zip",
    ],
    outs = ["bundle.zip"],
    cmd = """
set -euo pipefail
out_path="$$(pwd)/$@"
bundle_root="$(@D)/cooked_bundle_root"
rm -rf "$$bundle_root"
mkdir -p "$$bundle_root/terrain"
/usr/bin/unzip -q "$(location :bundle_uncooked)" -d "$$bundle_root"
/usr/bin/unzip -q -o "$(location :terrain_recipes.zip)" -d "$$bundle_root"
find "$$bundle_root" -exec touch -t 198001010000 {} +
(cd "$$bundle_root" && find . -mindepth 1 | sed 's|^\\./||' | LC_ALL=C sort | /usr/bin/zip -q -X -@ "$$out_path")
rm -rf "$$bundle_root"
""",
)

# What a level editor may place, from the finished bundle in the same build:
# names, ids, default grounding and collider bounds of every prop template
# (docs/LEVEL_AUTHORING_TOOLS_PLAN.md P4). Ships beside bundle.bytes, not in it.
genrule(
    name = "placeable_registry",
    srcs = [":bundle"],
    outs = ["placeable_registry.json"],
    cmd = "$(location //game_server:placeable_registry) $(location :bundle) gameplay_catalog.yaml $@",
    tools = ["//game_server:placeable_registry"],
)
