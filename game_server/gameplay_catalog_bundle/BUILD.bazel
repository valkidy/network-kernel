licenses(["notice"])

package(default_visibility = ["//visibility:public"])

genrule(
    name = "gameplay_bundle_base",
    srcs = ["//game_server:gameplay_catalog_bundle_sources"],
    outs = ["gameplay_bundle_base.zip"],
    cmd = """
set -euo pipefail
out_path="$$(pwd)/$@"
bundle_root="$(@D)/bundle_root"
rm -rf "$$bundle_root"
mkdir -p "$$bundle_root/action_templates" "$$bundle_root/action_graph_templates" "$$bundle_root/status_effect_templates" "$$bundle_root/sp_attack_templates" "$$bundle_root/weapon_templates" "$$bundle_root/projectile_templates" "$$bundle_root/collider_templates" "$$bundle_root/entity_templates" "$$bundle_root/item_templates" "$$bundle_root/patrol_templates" "$$bundle_root/skeleton_assets/generated" "$$bundle_root/stamp_templates" "$$bundle_root/terrain_assets"
for src in $(SRCS); do
  case "$$src" in
    */test_catalogs/legged_locomotion/gameplay_catalog.yaml)
      cp "$$src" "$$bundle_root/legged_locomotion_gameplay_catalog.yaml"
      ;;
    */gameplay_catalog.yaml)
      cp "$$src" "$$bundle_root/gameplay_catalog.yaml"
      # One entry per map variant, the catalog with map_variant set to it, so
      # a server picks the map by entry path without a rebuild.
      for variant in kernel_terrain composed_mesh; do
        sed "s/^map_variant: .*/map_variant: $$variant/" "$$src" > "$$bundle_root/gameplay_catalog.$$variant.yaml"
        grep -q "^map_variant: $$variant$$" "$$bundle_root/gameplay_catalog.$$variant.yaml"
      done
      ;;
    */weapon_templates/*.yaml)
      cp "$$src" "$$bundle_root/weapon_templates/$$(basename "$$src")"
      ;;
    */action_templates/*.yaml)
      cp "$$src" "$$bundle_root/action_templates/$$(basename "$$src")"
      ;;
    */action_graph_templates/*.yaml)
      # Graphs keep their subdirectory (common/, derived/<owner_type>/). The
      # loader reads the whole tree; flattening it here would let two
      # same-named files overwrite each other instead of being refused.
      graph_path="$${src#*/action_graph_templates/}"
      mkdir -p "$$bundle_root/action_graph_templates/$$(dirname "$$graph_path")"
      cp "$$src" "$$bundle_root/action_graph_templates/$$graph_path"
      ;;
    */status_effect_templates/*.yaml)
      cp "$$src" "$$bundle_root/status_effect_templates/$$(basename "$$src")"
      ;;
    */sp_attack_templates/*.yaml)
      cp "$$src" "$$bundle_root/sp_attack_templates/$$(basename "$$src")"
      ;;
    */projectile_templates/*.yaml)
      cp "$$src" "$$bundle_root/projectile_templates/$$(basename "$$src")"
      ;;
    */entity_templates/*.yaml)
      cp "$$src" "$$bundle_root/entity_templates/$$(basename "$$src")"
      ;;
    */item_templates/*.yaml)
      cp "$$src" "$$bundle_root/item_templates/$$(basename "$$src")"
      ;;
    */collider_templates/*.yaml)
      cp "$$src" "$$bundle_root/collider_templates/$$(basename "$$src")"
      ;;
    */patrol_templates/*.yaml)
      cp "$$src" "$$bundle_root/patrol_templates/$$(basename "$$src")"
      ;;
    */stamp_templates/*.yaml|*/stamp_templates/*.hf)
      cp "$$src" "$$bundle_root/stamp_templates/$$(basename "$$src")"
      ;;
    */terrain_assets/*.nkgm|*/terrain_assets/*.nkgl)
      cp "$$src" "$$bundle_root/terrain_assets/$$(basename "$$src")"
      ;;
    */skeleton_assets/generated/*.ozz|*/skeleton_assets/generated/*.skeleton_manifest.json|*/skeleton_assets/generated/*.rig.yaml)
      cp "$$src" "$$bundle_root/skeleton_assets/generated/$$(basename "$$src")"
      ;;
  esac
done
# Normalize entry timestamps and ordering so the archive is byte-reproducible:
# clients key their catalog cache by the bundle SHA-256, so build-time mtimes
# would invalidate every cached bundle on each rebuild.
find "$$bundle_root" -exec touch -t 198001010000 {} +
(cd "$$bundle_root" && find . -mindepth 1 | sed 's|^\\./||' | LC_ALL=C sort | /usr/bin/zip -q -X -@ "$$out_path")
rm -rf "$$bundle_root"
""",
)

# Everything but the cooked terrain recipe; terrain_recipe reads it to
# generate the recipe, and bundle adds it.
genrule(
    name = "bundle_uncooked",
    srcs = [
        ":gameplay_bundle_base",
        "//game_server/gameplay_catalog/mesh_assets:cooked_mesh_assets",
    ],
    outs = ["bundle_uncooked.zip"],
    cmd = """
set -euo pipefail
out_path="$$(pwd)/$@"
bundle_root="$(@D)/merged_bundle_root"
rm -rf "$$bundle_root"
mkdir -p "$$bundle_root/mesh_assets/jolt" "$$bundle_root/mesh_assets/recast"
for src in $(SRCS); do
  case "$$src" in
    */gameplay_bundle_base.zip)
      /usr/bin/unzip -q "$$src" -d "$$bundle_root"
      ;;
    */mesh_assets/jolt/*.joltmesh)
      cp "$$src" "$$bundle_root/mesh_assets/jolt/$$(basename "$$src")"
      ;;
    */mesh_assets/recast/*.navmesh)
      cp "$$src" "$$bundle_root/mesh_assets/recast/$$(basename "$$src")"
      ;;
  esac
done
find "$$bundle_root" -exec touch -t 198001010000 {} +
(cd "$$bundle_root" && find . -mindepth 1 | sed 's|^\\./||' | LC_ALL=C sort | /usr/bin/zip -q -X -@ "$$out_path")
rm -rf "$$bundle_root"
""",
)

# The terrain level's recipe, generated (layout, checks, retries, fallback)
# from the catalog's seed at build time, so every server and client of this
# bundle composes the same map (docs/KERNEL_TERRAIN_IMPLEMENTATION_PLAN.md P3).
# The report lists every attempt.
genrule(
    name = "terrain_recipe",
    srcs = [":bundle_uncooked"],
    outs = [
        "gameplay_catalog.nktr",
        "terrain_recipe_report.txt",
    ],
    cmd = "$(location //game_server:terrain_recipe_cook) $(location :bundle_uncooked) gameplay_catalog.yaml $(location gameplay_catalog.nktr) kernel_terrain > $(location terrain_recipe_report.txt)",
    tools = ["//game_server:terrain_recipe_cook"],
)

# One recipe per terrain scene template (docs/SCENE_TABLE_PLAN.md S2), at the
# path the template's terrain.recipe names.
genrule(
    name = "terrain_recipe_level_terrain_seed2",
    srcs = [":bundle_uncooked"],
    outs = [
        "level_terrain_seed2.nktr",
        "terrain_recipe_level_terrain_seed2_report.txt",
    ],
    cmd = "$(location //game_server:terrain_recipe_cook) $(location :bundle_uncooked) gameplay_catalog.yaml $(location level_terrain_seed2.nktr) scene_template:level_terrain_seed2 > $(location terrain_recipe_level_terrain_seed2_report.txt)",
    tools = ["//game_server:terrain_recipe_cook"],
)

genrule(
    name = "bundle",
    srcs = [
        ":bundle_uncooked",
        ":gameplay_catalog.nktr",
        ":level_terrain_seed2.nktr",
    ],
    outs = ["bundle.zip"],
    cmd = """
set -euo pipefail
out_path="$$(pwd)/$@"
bundle_root="$(@D)/cooked_bundle_root"
rm -rf "$$bundle_root"
mkdir -p "$$bundle_root/terrain"
/usr/bin/unzip -q "$(location :bundle_uncooked)" -d "$$bundle_root"
cp "$(location :gameplay_catalog.nktr)" "$$bundle_root/terrain/gameplay_catalog.nktr"
cp "$(location :level_terrain_seed2.nktr)" "$$bundle_root/terrain/level_terrain_seed2.nktr"
find "$$bundle_root" -exec touch -t 198001010000 {} +
(cd "$$bundle_root" && find . -mindepth 1 | sed 's|^\\./||' | LC_ALL=C sort | /usr/bin/zip -q -X -@ "$$out_path")
rm -rf "$$bundle_root"
""",
)
