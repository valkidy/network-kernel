        "patrol_director.h",
        "patrol_group_runtime.h",
        "patrol_navigation.h",
        "spawn_sampling.h",
        "world_rule_director.h",
        "public/game_server_types.h",
    ],
    deps = [
        "//engine/components/ai:ai",
        "//engine/src/kernel:kernel_api",
        "//engine/src/kernel:kernel_api_internal",
        "@recastnavigation//:detour",
        "@spdlog//:spdlog",
        "@zip_archive//:zip",
        "@yaml-cpp//:yaml-cpp",
    ],
)

cc_test(
    name = "gameplay_config_test",
    srcs = ["gameplay_config_test.cc"],
    data = glob([
        "action_graph_templates/*.yaml",
        "status_effect_templates/*.yaml",
        "action_templates/*.yaml",
        "collider_templates/*.yaml",
        "entity_templates/*.yaml",
        "item_templates/*.yaml",
        "projectile_templates/*.yaml",
        "weapon_templates/*.yaml",
    ]) + [
        "//game_server/gameplay_catalog_bundle:bundle",
        "gameplay_catalog.yaml",
        # Present so the skeleton_manifests_dir scan is exercised against a
        # directory the catalog never names file-by-file.
        "//game_server/skeleton_assets:simplified_biped_assets",
        "//game_server/skeleton_assets:simplified_quadruped_assets",
        "//game_server/skeleton_assets:simplified_tripod_assets",
    ],
    deps = [
        ":game_server",
        ":game_server_bridge",
        "//engine/src/kernel:kernel",
    ],
)

# What a listen host presents for a rig it simulates itself, checked against a
# separate client kernel fed the same wire content; see the file header.
cc_test(
    name = "listen_host_pose_parity_test",
    srcs = ["listen_host_pose_parity_test.cc"],
    data = [
        "//game_server/gameplay_catalog_bundle:bundle",
    ],
    deps = [
        ":game_server",
        "//engine/src/kernel:kernel",
    ],
)

# The authoritative half of per-bone limb colliders, and the reference the
# client side is compared against. Runs on a dedicated-server kernel because
# that is the shipping environment; see the file header.
cc_test(
    name = "limb_collider_test",
    srcs = ["limb_collider_test.cc"],
    data = [
        "//game_server/gameplay_catalog_bundle:bundle",
    ],
    deps = [
        ":game_server",
        ":game_server_bridge",
        "//engine/src/kernel:kernel",
    ],
)

# Reports timings, so it is a manual benchmark rather than a CI gate: a
# wall-clock bound would be flaky and host-dependent.
cc_test(
    name = "limb_broad_phase_bench",
    srcs = ["limb_broad_phase_bench.cc"],
    data = [
        "//game_server/gameplay_catalog_bundle:bundle",
    ],
    tags = ["manual"],
    deps = [
        ":game_server",
        ":game_server_bridge",
        "//engine/src/kernel:kernel",
    ],
)

