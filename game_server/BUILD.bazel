licenses(["notice"])

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "gameplay_catalog_bundle_sources",
    srcs = glob([
        "action_graph_templates/*.yaml",
        "status_effect_templates/*.yaml",
        "action_templates/*.yaml",
        "collider_templates/*.yaml",
        "entity_templates/*.yaml",
        "item_templates/*.yaml",
        "projectile_templates/*.yaml",
        "weapon_templates/*.yaml",
    ]) + [
        "gameplay_catalog.yaml",
        "test_catalogs/legged_locomotion/gameplay_catalog.yaml",
        "//game_server/skeleton_assets:simplified_biped_assets",
        "//game_server/skeleton_assets:simplified_quadruped_assets",
        "//game_server/skeleton_assets:simplified_tripod_assets",
    ],
)

cc_library(
    name = "game_server",
    srcs = [
        "actor_intent_executor.cc",
        "ai_perception_adapter.cc",
        "agent_chaser_controller.cc",
        "agent_sentry_controller.cc",
        "agent_steering.cc",
        "agent_runtime_manager.cc",
        "ballistic_aim.cc",
        "gameplay_config.cc",
        "game_server.cc",
    ],
    hdrs = [
        "actor_intent_executor.h",
        "ai_perception_adapter.h",
        "agent_chaser_controller.h",
        "agent_runtime.h",
        "agent_runtime_manager.h",
        "agent_sentry_controller.h",
        "agent_steering.h",
        "ballistic_aim.h",
        "gameplay_config.h",
        "game_server.h",
        "public/game_server_types.h",
    ],
    deps = [
        "//engine/components/ai:ai",
        "//engine/src/kernel:kernel_api",
        "//engine/src/kernel:kernel_api_internal",
        "@spdlog//:spdlog",
        "@zip_archive//:zip",
        "@yaml-cpp//:yaml-cpp",
    ],
)

cc_test(
    name = "gameplay_config_test",
    srcs = ["gameplay_config_test.cc"],
    data = glob([
        "action_graph_templates/*.yaml",
        "status_effect_templates/*.yaml",
        "action_templates/*.yaml",
        "collider_templates/*.yaml",
        "entity_templates/*.yaml",
        "item_templates/*.yaml",
        "projectile_templates/*.yaml",
        "weapon_templates/*.yaml",
    ]) + [
        "//game_server/gameplay_catalog_bundle:bundle",
        "gameplay_catalog.yaml",
        # Present so the skeleton_manifests_dir scan is exercised against a
        # directory the catalog never names file-by-file.
        "//game_server/skeleton_assets:simplified_biped_assets",
        "//game_server/skeleton_assets:simplified_quadruped_assets",
        "//game_server/skeleton_assets:simplified_tripod_assets",
    ],
    deps = [
        ":game_server",
        ":game_server_bridge",
        "//engine/src/kernel:kernel",
    ],
)

