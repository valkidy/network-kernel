licenses(["notice"])

package(default_visibility = ["//visibility:public"])

# Read by //tools:check_layering_boundaries.
exports_files(["BUILD.bazel"])

filegroup(
    name = "gameplay_catalog_bundle_sources",
    srcs = glob([
        "action_graph_templates/*.yaml",
        "status_effect_templates/*.yaml",
        "action_templates/*.yaml",
        "collider_templates/*.yaml",
        "entity_templates/*.yaml",
        "item_templates/*.yaml",
        "projectile_templates/*.yaml",
        "weapon_templates/*.yaml",
    ]) + [
        "gameplay_catalog.yaml",
        "test_catalogs/legged_locomotion/gameplay_catalog.yaml",
        "//game_server/skeleton_assets:simplified_biped_assets",
        "//game_server/skeleton_assets:simplified_quadruped_assets",
        "//game_server/skeleton_assets:simplified_tripod_assets",
    ],
)

