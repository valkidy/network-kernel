    name = "patrol_nav_bench",
    srcs = ["tests/patrol_nav_bench.cc"],
    data = [
        "//game_server/gameplay_catalog_bundle:bundle",
        "//game_server/tests/test_mesh_assets:cooked_test_mesh_assets",
    ],
    tags = ["manual"],
    deps = [
        ":game_server",
        "@recastnavigation//:detour",
    ],
)

