cc_test(
    name = "gameplay_config_test",
    srcs = ["tests/gameplay_config_test.cc"],
    data = glob([
        "gameplay_catalog/action_graph_templates/*.yaml",
        "gameplay_catalog/status_effect_templates/*.yaml",
        "gameplay_catalog/action_templates/*.yaml",
        "gameplay_catalog/collider_templates/*.yaml",
        "gameplay_catalog/entity_templates/*.yaml",
        "gameplay_catalog/item_templates/*.yaml",
        "gameplay_catalog/projectile_templates/*.yaml",
        "gameplay_catalog/weapon_templates/*.yaml",
    ]) + [
        "//game_server/gameplay_catalog_bundle:bundle",
        "gameplay_catalog/gameplay_catalog.yaml",
        # Present so the skeleton_manifests_dir scan is exercised against a
        # directory the catalog never names file-by-file.
        "//game_server/gameplay_catalog/skeleton_assets:simplified_biped_assets",
        "//game_server/gameplay_catalog/skeleton_assets:simplified_quadruped_assets",
        "//game_server/gameplay_catalog/skeleton_assets:simplified_tripod_assets",
        # The scene and the navmesh the catalog names, so the file branch can
        # be checked against the bundle branch.
        "//game_server/gameplay_catalog/mesh_assets:cooked_mesh_assets",
    ],
    deps = [
        ":game_server",
        ":game_server_bridge",
        "//engine/src/kernel:kernel",
    ],
)

