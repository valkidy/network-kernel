# =============================================================================
# Locomotion capture
# =============================================================================
#
# Records the monster's locomotion twice -- once against the freshly built
# kernel ("native"), once against the dylib shipped in the Unity package
# ("plugin") -- through the public Kernel/GameServer C ABI, in the same call
# order the Unity plugin's NetworkHost.Start / NetworkHost.Update use. Then it
# renders both captures to mp4 and diffs them.
#
# Usage:
#
#   bazel run --config=macos -c opt \
#     //engine/src/tests/kernel_tests:locomotion_capture -- \
#     --sampling=300 --path="+X"
#
# Arguments (all optional):
#
#   --sampling=N     samples to record. Default 300 = 10 s at 30 Hz.
#   --tick-rate=HZ   simulation rate. Default 30. Duration = sampling/tick-rate.
#   --path=SCRIPT    movement description. Default "+X" (walk +X forever).
#                    Steps are separated by ';':
#                      +X | -X | +Z | -Z   set the heading
#                      forward <n>m        walk until n metres of XZ travel
#                      turn <n>            rotate the heading n degrees
#                                          (+X toward +Z is positive)
#                      wait <n>s           stand still for n seconds
#                    Chinese keywords work too (前進 / 旋轉 / 等待), e.g.
#                      --path="+X前進10m; 旋轉45度; 前進5m"
#                    When the script runs out the subject stands still for the
#                    remaining samples; a bare axis never runs out.
#   --spawn=x,y,z    subject spawn position. Default 0,10,0.
#   --skip-plugin    only run the native capture (no plugin staging, no diff).
#   --venv=DIR       virtualenv for the Python steps. Default capture/.venv.
#   --recreate-venv  rebuild that virtualenv before running.
#   --no-venv        use the host python3 as-is and install nothing (only works
#                    if numpy and matplotlib already import there).
#
# Python environment: rendering needs numpy and matplotlib, and macOS/homebrew
# interpreters are externally managed (PEP 668), so nothing is ever installed
# into the host python. The first run creates capture/.venv and installs
# tools/capture/requirements.txt into it (needs network once); later runs reuse
# it. ffmpeg still has to come from the host -- `brew install ffmpeg`.
#
# Outputs, always written to capture/locomotion_tests/ in the source tree:
#
#   native_locomotion.mp4  native_raw_bones.csv  native_raw_root.csv
#   plugin_locomotion.mp4  plugin_raw_bones.csv  plugin_raw_root.csv
#   report.txt             native <-> plugin parity + path acceptance
#
# The run fails (non-zero) when the Python environment cannot be provisioned,
# when a capture ends early, or when native and plugin disagree beyond
# tolerance.
#
# Why bazel run and not a genrule: the two runtime arguments (--sampling,
# --path) cannot reach a genrule, whose command line is fixed at analysis time,
# and a genrule can only write into bazel-out, while the deliverable has to
# land in capture/locomotion_tests/ in the source tree. Both need the
# BUILD_WORKSPACE_DIRECTORY that only `bazel run` provides. The rendering step
# alone would fit a genrule, but it runs out of the capture venv against host
# ffmpeg, so it would not be hermetic either way; the orchestrator preflights
# that environment instead and fails with an explicit error.
sh_binary(
    name = "locomotion_capture",
    srcs = ["//tools/capture:run_locomotion_capture.sh"],
    args = [
        "--driver=$(location :locomotion_capture_driver)",
        "--dylib=$(location //engine/src/kernel:network_kernel_shared)",
        "--bundle=$(location //game_server/gameplay_catalog_bundle:bundle)",
        "--manifest=$(location //game_server/skeleton_assets:generated/simplified_monster_sim_v4.skeleton_manifest.json)",
        "--preflight=$(location //tools/capture:capture_preflight.py)",
        "--render=$(location //tools/capture:render_transforms.py)",
        "--analyze=$(location //tools/capture:analyze_capture.py)",
        "--requirements=$(location //tools/capture:requirements.txt)",
    ],
    data = [
        ":locomotion_capture_driver",
        "//engine/src/kernel:network_kernel_shared",
        "//game_server/gameplay_catalog_bundle:bundle",
        "//game_server/skeleton_assets:generated/simplified_monster_sim_v4.skeleton_manifest.json",
        "//tools/capture:analyze_capture.py",
        "//tools/capture:capture_preflight.py",
        "//tools/capture:render_transforms.py",
        "//tools/capture:requirements.txt",
    ],
)

